# Root .env is loaded automatically by both binaries
# (existing shell env vars take precedence over the file).
#
# ============================================================
# Eva API (JSON-RPC 2.2, per oas_evateam_v1_9_22.json)
#   POST {EVA_RPC_URL}/?m=CmfTask.list
#   body: {"jsonrpc":"2.2","method":"CmfTask.list","callid":"<uuid>",
#          "kwargs":{"filter":[[f,op,v],...],"slice":[offset,limit]}}
# ============================================================
EVA_RPC_URL=https://eva.staff.rfn.ru/api

# ---- Auth (priority: API token > custom header > login/password) ----
# Recommended: API token created in Eva. Sent as "Authorization: Bearer <token>".
EVA_API_TOKEN=
# Header scheme used for the token (set to "none" to send the raw token)
EVA_APITOKEN_HEADER=Authorization
EVA_APITOKEN_SCHEME=Bearer
# Custom static header "Name: Value" (e.g. "X-API-Key: abc"). Lower priority
# than EVA_API_TOKEN, higher than login/password.
EVA_AUTH_HEADER=
# SSO login fallback (for the rfn "Авторизация" SSO): the client POSTs
# login+password to EVA_AUTH_LOGIN_URL, stores the session cookie and reuses
# it. Only used when EVA_API_TOKEN is empty.
EVA_LOGIN=
EVA_PASSWORD=
EVA_AUTH_LOGIN_URL=https://eva.staff.rfn.ru/auth/signin

# ---- Task methods / fields (match the OAS spec) ----
EVA_TASK_LIST_METHOD=CmfTask.list
EVA_TASK_GET_METHOD=CmfTask.get
# CmfComment.list ordered by cmf_created_at gives the task's comments
EVA_TASK_COMMENTS_METHOD=CmfComment.list
# Relations between tasks live in the CmfRelationOption model
EVA_TASK_LINK_METHOD=CmfRelationOption.create
# Relation type to use when linking similar tasks (valid types are instance
# specific, e.g. "related", "parent", "blocks")
EVA_LINK_RELATION_TYPE=related
# JSON filter triples applied to every CmfTask.list page, e.g.
#   [["status","!=","closed"]]
EVA_TASK_LIST_FILTER=
# JSON field of the task object that holds the task id (uuid), and its code
EVA_TASK_ID_FIELD=id
EVA_TASK_CODE_FIELD=code
# CmfTask.get resolves the task via filter [[<field>,"==",id]]
EVA_TASK_GET_FILTER_FIELD=id
# Fields used to build the embedding text (Eva task "name" = заголовок,
# "text" = HTML-описание; result = итог, часто кастомное поле)
EVA_TASK_TITLE_FIELD=name
EVA_TASK_DESC_FIELD=text
EVA_TASK_RESULT_FIELD=result
# CmfComment field holding the text and the reference to the task
EVA_TASK_COMMENT_FIELD=text
EVA_TASK_COMMENT_PARENT_FIELD=parent
EVA_TASK_COMMENT_PARENT_PREFIX=CmfTask:
# Comma-separated extra fields to attach to the Qdrant payload
EVA_TASK_PAYLOAD_FIELDS=number,project_id,status

# ============================================================
# Embedding provider
# ============================================================
# One of: ollama | tei
EMBED_PROVIDER=ollama
# Ollama runs on the host (NOT in docker-compose). MacOS users: from a
# container you would need host.docker.internal, but the Go services run on
# the host, so localhost works.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
TEI_URL=http://localhost:8081
# Fixed embedding dimension (Ollama nomic-embed-text = 768)
EMBED_DIM=768
# Maximum tokens/chars sent per text field
EMBED_MAX_CHARS=6000

# ============================================================
# Qdrant
# ============================================================
QDRANT_URL=http://localhost:46333
QDRANT_COLLECTION=eva_tasks
QDRANT_DISTANCE=Cosine

# ============================================================
# Indexer (batch)
# ============================================================
INDEXER_PAGE_SIZE=100
INDEXER_BATCH_SIZE=16
# Rebuild collection from scratch instead of upserting
INDEXER_RECREATE=false

# ============================================================
# Listener (webhook)
# ============================================================
LISTENER_ADDR=:8080
LISTENER_WEBHOOK_PATH=/webhook/task
# Token Eva sends with webhooks. Accepted via "Authorization: Bearer <token>",
# the "X-Webhook-Token" header, or "?token=". All /webhook and /index,/link
# endpoints are rejected with 401 when this is set.
WEBHOOK_TOKEN=
# JSON pointer to the task id inside the webhook payload, e.g. "task.id"
LISTENER_TASK_ID_PATH=id
# Only tasks at or above this cosine similarity get linked
LISTENER_SCORE_THRESHOLD=0.75
# Max number of similar tasks to link per event
LISTENER_MAX_LINKS=5
# When true, do not call Eva to create links — only log them
LINKS_DRY_RUN=true

# Log level: debug | info | warn
LOG_LEVEL=info